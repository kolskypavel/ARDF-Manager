<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/startlist_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        android:minHeight="?attr/actionBarSize"
        android:theme="@style/Theme.ARDFManager"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/competitor_draw_start_times" />

    <!-- Fixed top part -->
    <CheckBox
        android:id="@+id/startlist_separate_same_club_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:text="@string/startlist_separate_clubs"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/startlist_toolbar" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/startlist_interval_layout"
        style="@style/dialog_textView"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="6dp"
        android:hint="@string/startlist_hint_interval"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/startlist_separate_same_club_checkbox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/startlist_interval_input"
            style="@style/dialog_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:maxLength="5" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/startlist_category_interval_layout"
        style="@style/dialog_textView"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="6dp"
        android:hint="@string/startlist_hint_category_interval"
        app:layout_constraintStart_toEndOf="@id/startlist_interval_layout"
        app:layout_constraintTop_toBottomOf="@id/startlist_separate_same_club_checkbox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/startlist_category_interval_input"
            style="@style/dialog_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:maxLength="5" />
    </com.google.android.material.textfield.TextInputLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/startlist_categories_recycler"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="12dp"
        android:minHeight="60dp"
        android:overScrollMode="never"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/startlist_set_interval_btn" />

    <Button
        android:id="@+id/startlist_set_interval_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/startlist_set_interval"
        app:layout_constraintEnd_toEndOf="@+id/startlist_category_interval_layout"
           app:layout_constraintTop_toBottomOf="@+id/startlist_category_interval_layout" />

    <!-- Scrollable grid area -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/startlist_grid_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/startlist_categories_recycler">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/startlist_grid_recycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:paddingBottom="80dp" />
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/startlist_btn_draw"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="32dp"
        android:src="@drawable/ic_draw"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
